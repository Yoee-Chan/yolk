<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yolk.traffic.mapper.UsageRecordMapper">

    <resultMap id="UsageRecordResultMap" type="com.yolk.traffic.entity.UsageRecordEntity">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="periodType" column="period_type"/>
        <result property="label" column="label"/>
        <result property="tokens" column="tokens"/>
        <result property="recordedAt" column="recorded_at"/>
    </resultMap>

    <select id="findByUserIdAndPeriodBetween" resultMap="UsageRecordResultMap">
        SELECT id, user_id, period_type, label, tokens, recorded_at
        FROM usage_records
        WHERE user_id = #{userId}
          AND period_type = #{periodType}
          AND recorded_at BETWEEN #{start} AND #{end}
        ORDER BY recorded_at, label
    </select>
</mapper>
