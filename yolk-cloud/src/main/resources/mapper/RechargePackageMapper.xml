<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yolk.traffic.mapper.RechargePackageMapper">

    <resultMap id="RechargePackageResultMap" type="com.yolk.traffic.entity.RechargePackageEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="tokens" column="tokens"/>
        <result property="price" column="price"/>
        <result property="originalPrice" column="original_price"/>
        <result property="tag" column="tag"/>
        <result property="hot" column="hot"/>
    </resultMap>

    <select id="findById" resultMap="RechargePackageResultMap">
        SELECT id, name, tokens, price, original_price, tag, hot
        FROM recharge_packages
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="RechargePackageResultMap">
        SELECT id, name, tokens, price, original_price, tag, hot
        FROM recharge_packages
        ORDER BY price
    </select>
</mapper>
