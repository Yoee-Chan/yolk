<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yolk.auth.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.yolk.auth.entity.UserEntity">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="nickname" column="nickname"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="UserColumns">
        id, email, phone, password_hash, nickname, avatar_url, created_at
    </sql>

    <select id="findById" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM users
        WHERE id = #{id}
    </select>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM users
        WHERE email = #{email}
    </select>

    <select id="findByPhone" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM users
        WHERE phone = #{phone}
    </select>

    <select id="existsByEmail" resultType="boolean">
        SELECT COUNT(1) > 0 FROM users WHERE email = #{email}
    </select>

    <select id="existsByPhone" resultType="boolean">
        SELECT COUNT(1) > 0 FROM users WHERE phone = #{phone}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (email, phone, password_hash, nickname, avatar_url, created_at)
        VALUES (#{email}, #{phone}, #{passwordHash}, #{nickname}, #{avatarUrl}, #{createdAt})
    </insert>

    <update id="update">
        UPDATE users
        SET email = #{email},
            phone = #{phone},
            password_hash = #{passwordHash},
            nickname = #{nickname},
            avatar_url = #{avatarUrl}
        WHERE id = #{id}
    </update>
</mapper>
