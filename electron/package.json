{
  "name": "electron-python-demo",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.demo.electronpython",
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../python/dist",
        "to": "python",
        "filter": [
          "hello.exe"
        ]
      }
    ],
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  }
}
